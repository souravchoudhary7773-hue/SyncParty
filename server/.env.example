# Watch Party Environment Variables Template

# Port configuration
PORT=4000
NODE_ENV=development

# Cloud MongoDB Connection URI (MongoDB Atlas Free M0 Cluster)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/watchparty?retryWrites=true&w=majority
MONGODB_URI=

# Cloud Redis Connection URL (Upstash Redis Free Tier)
# Example: rediss://default:your_password@your-endpoint.upstash.io:6379
REDIS_URL=
USE_REDIS=false
